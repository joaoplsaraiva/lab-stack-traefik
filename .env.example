# ==============================================================================
# Copie para .env e ajuste:  cp .env.example .env && chmod 600 .env
# O arquivo .env NUNCA deve ser versionado.
# ==============================================================================

# Domínio base do laboratório (gera traefik.<DOMAIN>, grafana.<DOMAIN>, ...)
DOMAIN=domain.local

# IP do host Docker (usado por scripts/hosts.sh e scripts/smoke-test.sh)
HOST_IP=192.168.56.6

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TroqueEstaSenhaPorUmaForte

# Usuário do BasicAuth (dashboard Traefik, Jaeger, Prometheus, Grafana)
BASIC_AUTH_USER=admin

# Traefik
TRAEFIK_LOG_LEVEL=INFO

# Prometheus
PROMETHEUS_RETENTION=15d

# ------------------------------------------------------------------------------
# Versões das imagens (fixe versões para builds reproduzíveis)
# ------------------------------------------------------------------------------
TRAEFIK_IMAGE=traefik:v3.7
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:latest
WHOAMI_IMAGE=traefik/whoami:latest
PORTAINER_IMAGE=portainer/portainer-ce:lts
JAEGER_IMAGE=jaegertracing/jaeger:2.20.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
LOKI_IMAGE=grafana/loki:3.5.0
ALLOY_IMAGE=grafana/alloy:v1.10.0
GRAFANA_IMAGE=grafana/grafana:13.2.1
